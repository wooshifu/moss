#pragma once

// 简化的 atomic 支持，用于 MOSS 混合内核
// 主要用于防止缺少 <atomic> 的编译错误

// 对于大部分情况，我们的 atomic_types.hpp 已经提供了所需的原子操作
// 这个头文件主要是为了满足编译要求

namespace std {
    // 基本的原子类型前向声明
    // 实际实现在 atomic_types.hpp 中
    template<typename T>
    struct atomic;

    // 内存序列枚举
    enum memory_order {
        memory_order_relaxed,
        memory_order_consume,
        memory_order_acquire,
        memory_order_release,
        memory_order_acq_rel,
        memory_order_seq_cst
    };

    // 原子线程围栏（简化版本）
    inline void atomic_thread_fence(memory_order order) noexcept {
        // 在实际内核中，这里会调用架构特定的内存屏障指令
        // 目前简化为编译器屏障
        __asm__ __volatile__("" ::: "memory");
        (void)order; // 暂时忽略内存序列
    }
}

// 包含我们实际的原子类型实现
#include "../containers/atomic_types.hpp"