// ============================================================================
// 调试和断言配置系统
// ============================================================================

// 调试级别控制（由CMake设置）
#define MOSS_DEBUG_LEVEL @MOSS_DEBUG_LEVEL@

// 内存调试功能
#if MOSS_DEBUG_LEVEL >= 2
    #define MOSS_ENABLE_MEMORY_DEBUG @MOSS_ENABLE_MEMORY_DEBUG@       // 内存调试
    #define MOSS_ENABLE_STACK_OVERFLOW_CHECK @MOSS_ENABLE_STACK_OVERFLOW_CHECK@ // 栈溢出检测
    #define MOSS_ENABLE_HEAP_CORRUPTION_CHECK @MOSS_ENABLE_HEAP_CORRUPTION_CHECK@ // 堆损坏检测
    #define MOSS_ENABLE_DOUBLE_FREE_CHECK @MOSS_ENABLE_DOUBLE_FREE_CHECK@     // 双重释放检测
#endif

// 断言和验证
#if MOSS_DEBUG_LEVEL >= 1
    #define MOSS_ENABLE_ASSERTIONS @MOSS_ENABLE_ASSERTIONS@         // 运行时断言
    #define MOSS_ENABLE_DATA_STRUCTURE_CHECK @MOSS_ENABLE_DATA_STRUCTURE_CHECK@ // 数据结构一致性检查

    // 断言宏定义
    #define MOSS_STRINGIFY(x) #x
    #define MOSS_TOSTRING(x) MOSS_STRINGIFY(x)

    #define MOSS_ASSERT(condition) \
        do { \
            if (!(condition)) { \
                moss_kernel_panic("Assertion failed: " #condition \
                                " at " __FILE__ ":" MOSS_TOSTRING(__LINE__)); \
            } \
        } while(0)

    #define MOSS_ASSERT_MSG(condition, msg) \
        do { \
            if (!(condition)) { \
                moss_kernel_panic("Assertion failed: " #condition \
                                ": " msg " at " __FILE__ ":" MOSS_TOSTRING(__LINE__)); \
            } \
        } while(0)
#else
    #define MOSS_ASSERT(condition) ((void)0)
    #define MOSS_ASSERT_MSG(condition, msg) ((void)0)
#endif

// 性能分析和跟踪
#if MOSS_DEBUG_LEVEL >= 3
    #define MOSS_ENABLE_FUNCTION_TRACING @MOSS_ENABLE_FUNCTION_TRACING@   // 函数调用跟踪
    #define MOSS_ENABLE_LOCK_PROFILING @MOSS_ENABLE_LOCK_PROFILING@     // 锁性能分析
    #define MOSS_ENABLE_SCHEDULER_STATS @MOSS_ENABLE_SCHEDULER_STATS@    // 调度器统计
    #define MOSS_ENABLE_SYSCALL_TRACING @MOSS_ENABLE_SYSCALL_TRACING@    // 系统调用跟踪
#endif

