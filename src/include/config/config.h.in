// 核心模块（必须启用）
#define MOSS_ENABLE_CONTAINERS    1  // 容器库（基础依赖）
#define MOSS_ENABLE_MM           1  // 内存管理（核心功能）
#define MOSS_ENABLE_KERNEL       1  // 内核核心（必须启用）
