#define MOSS_FULL_VERSION_STRING MOSS_CONFIG_STRING " built on " MOSS_BUILD_TIMESTAMP

// 条件编译便利宏
#define MOSS_IF_ENABLED(feature, code) \
    do { \
        if constexpr (feature) { \
            code; \
        } \
    } while(0)

// 调试输出宏（需要在其他地方实现具体函数）
#if MOSS_DEBUG_LEVEL >= 1
    #define MOSS_DEBUG_PRINT(level, ...) \
        do { \
            if constexpr (level <= MOSS_DEBUG_LEVEL) { \
                moss_debug_printf("[DEBUG] " __VA_ARGS__); \
            } \
        } while(0)
#else
    #define MOSS_DEBUG_PRINT(level, ...) ((void)0)
#endif

// 内核恐慌函数声明（需要在kernel模块中实现）
#ifdef __cplusplus
extern "C" {
#endif

[[noreturn]] void moss_kernel_panic(const char* message);

#if MOSS_DEBUG_LEVEL >= 1
void moss_debug_printf(const char* format, ...);
#endif

#ifdef __cplusplus
}
#endif

// 静态断言检查关键配置
