// 依赖关系检查
#if defined(MOSS_ENABLE_PROCESS) && MOSS_ENABLE_PROCESS && (!defined(MOSS_ENABLE_IPC) || !MOSS_ENABLE_IPC)
    #error "Process management requires IPC support (MOSS_ENABLE_IPC)"
#endif

#if defined(MOSS_ENABLE_IPC) && MOSS_ENABLE_IPC && !defined(MOSS_ENABLE_MM)
    #error "IPC requires memory management support (MOSS_ENABLE_MM)"
#endif

#if ((defined(MOSS_ENABLE_DRIVERS) && MOSS_ENABLE_DRIVERS) || (defined(MOSS_ENABLE_INTERRUPTS) && MOSS_ENABLE_INTERRUPTS)) && !defined(MOSS_ENABLE_MM)
    #error "Drivers and interrupts require memory management support (MOSS_ENABLE_MM)"
#endif

