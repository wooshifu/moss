// Included inside the kernel and userspace syscall enums. Keep ABI numbers stable.
  // === Basic syscalls (0-9) ===
  SYS_DEBUG_PRINT = 0,
  SYS_EXIT = 1,
  SYS_GETPID = 2,
  SYS_GETPPID = 3,
  SYS_GETUID = 4,
  SYS_GETGID = 5,
  SYS_GETEUID = 6,
  SYS_GETEGID = 7,
  SYS_SETSID = 8,
  SYS_GETPGID = 9,

  // === Process management (10-29) ===
  SYS_FORK = 10,
  SYS_EXECVE = 11,
  SYS_WAIT4 = 12,
  SYS_WAITPID = 13,
  SYS_KILL = 14,
  SYS_SIGACTION = 15,
  SYS_SIGPROCMASK = 16,
