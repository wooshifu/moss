  SYS_SIGALTSTACK = 21,
  SYS_SETGID = 22,
  SYS_SETEUID = 23,
  SYS_SETEGID = 24,
  SYS_GETPGRP = 25,
  SYS_SETPGRP = 26,
  SYS_GETSID = 27,
  SYS_NICE = 28,
  SYS_GETPRIORITY = 29,

