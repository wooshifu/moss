{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "clang++-21",
                "CMAKE_ASM_COMPILER": "clang-21",
                "CMAKE_SYSTEM_NAME": "Generic",
                "MOSS_TARGET_PLATFORM": "QEMU_VIRT",
                "CMAKE_CXX_FLAGS": "-ffreestanding -fno-exceptions -fno-rtti -fno-stack-protector -Wall -Wextra -Werror -fno-pic -fno-pie"
            },
            "environment": {
                "CXX": "clang++-21"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": ["Linux"]
                }
            }
        },
        {
            "name": "arm64-base",
            "hidden": true,
            "inherits": "base",
            "displayName": "ARM64 Base Configuration",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "$penv{CMAKE_CXX_FLAGS} -mcpu=cortex-a57 -march=armv8-a+lse -mgeneral-regs-only -mstrict-align",
                "CMAKE_CXX_COMPILER_TARGET": "aarch64-linux-gnu",
                "CMAKE_ASM_COMPILER_TARGET": "aarch64-linux-gnu",
                "CMAKE_SYSTEM_PROCESSOR": "aarch64",
                "CMAKE_CROSSCOMPILING": "TRUE",
                "MOSS_TARGET_ARCH": "ARM64",
                "CMAKE_EXE_LINKER_FLAGS": "-nostdlib -static -z max-page-size=4096"
            }
        },
        {
            "name": "arm64-qemu-debug",
            "displayName": "ARM64 QEMU Debug",
            "description": "ARM64 debug build for QEMU virt platform",
            "inherits": "arm64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-Og -g3"
            }
        },
        {
            "name": "arm64-qemu-release",
            "displayName": "ARM64 QEMU Release",
            "description": "ARM64 release build for QEMU virt platform",
            "inherits": "arm64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
            }
        },
        {
            "name": "x86_64-base",
            "hidden": true,
            "inherits": "base",
            "displayName": "x86_64 Base Configuration",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "$penv{CMAKE_CXX_FLAGS} -mno-red-zone -mno-mmx -mno-sse -mno-sse2 -mno-sse3 -mno-ssse3 -mno-sse4.1 -mno-sse4.2 -mno-avx -mno-avx2 -mno-80387 -mno-fp-ret-in-387 -mtune=x86-64 -mcmodel=kernel",
                "CMAKE_CXX_COMPILER_TARGET": "x86_64-elf",
                "CMAKE_ASM_COMPILER_TARGET": "x86_64-elf",
                "CMAKE_SYSTEM_PROCESSOR": "x86_64",
                "CMAKE_CROSSCOMPILING": "FALSE",
                "MOSS_TARGET_ARCH": "X86_64",
                "CMAKE_EXE_LINKER_FLAGS": "-nostdlib -static -z max-page-size=4096 -z common-page-size=4096"
            }
        },
        {
            "name": "x86_64-qemu-debug",
            "displayName": "x86-64 QEMU Debug",
            "description": "x86-64 debug build for QEMU platform",
            "inherits": "x86_64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-Og -g3"
            }
        },
        {
            "name": "x86_64-qemu-release",
            "displayName": "x86-64 QEMU Release",
            "description": "x86-64 release build for QEMU platform",
            "inherits": "x86_64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
            }
        },
        {
            "name": "riscv-base",
            "hidden": true,
            "inherits": "base",
            "displayName": "RISC-V Base Configuration",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "$penv{CMAKE_CXX_FLAGS} -march=rv64imac -mabi=lp64 -mcmodel=medany -mstrict-align",
                "CMAKE_CXX_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_ASM_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_SYSTEM_PROCESSOR": "riscv64",
                "CMAKE_CROSSCOMPILING": "TRUE",
                "MOSS_TARGET_ARCH": "RISCV",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -nostdlib -nostartfiles",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld -nostdlib"
            }
        },
        {
            "name": "riscv-qemu-debug",
            "displayName": "RISC-V QEMU Debug",
            "description": "RISC-V 64 debug build for QEMU virt platform",
            "inherits": "riscv-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-Og -g3"
            }
        },
        {
            "name": "riscv-qemu-release",
            "displayName": "RISC-V QEMU Release",
            "description": "RISC-V 64 release build for QEMU virt platform",
            "inherits": "riscv-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "arm64-qemu-debug",
            "displayName": "ARM64 QEMU Debug Build",
            "configurePreset": "arm64-qemu-debug",
            "targets": ["moss.elf"]
        },
        {
            "name": "arm64-qemu-release",
            "displayName": "ARM64 QEMU Release Build",
            "configurePreset": "arm64-qemu-release",
            "targets": ["moss.elf"]
        },
        {
            "name": "x86_64-qemu-debug",
            "displayName": "x86-64 QEMU Debug Build",
            "configurePreset": "x86_64-qemu-debug",
            "targets": ["moss.elf"]
        },
        {
            "name": "x86_64-qemu-release",
            "displayName": "x86-64 QEMU Release Build",
            "configurePreset": "x86_64-qemu-release",
            "targets": ["moss.elf"]
        },
        {
            "name": "riscv-qemu-debug",
            "displayName": "RISC-V QEMU Debug Build",
            "configurePreset": "riscv-qemu-debug",
            "targets": ["moss.elf"]
        },
        {
            "name": "riscv-qemu-release",
            "displayName": "RISC-V QEMU Release Build",
            "configurePreset": "riscv-qemu-release",
            "targets": ["moss.elf"]
        }
    ],
    "workflowPresets": [
        {
            "name": "arm64-qemu-debug",
            "displayName": "ARM64 QEMU Debug Workflow",
            "description": "Complete ARM64 debug workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "arm64-qemu-debug"
                },
                {
                    "type": "build",
                    "name": "arm64-qemu-debug"
                }
            ]
        },
        {
            "name": "arm64-qemu-release",
            "displayName": "ARM64 QEMU Release Workflow",
            "description": "Complete ARM64 release workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "arm64-qemu-release"
                },
                {
                    "type": "build",
                    "name": "arm64-qemu-release"
                }
            ]
        },
        {
            "name": "x86_64-qemu-debug",
            "displayName": "x86-64 QEMU Debug Workflow",
            "description": "Complete x86-64 debug workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "x86_64-qemu-debug"
                },
                {
                    "type": "build",
                    "name": "x86_64-qemu-debug"
                }
            ]
        },
        {
            "name": "x86_64-qemu-release",
            "displayName": "x86-64 QEMU Release Workflow",
            "description": "Complete x86-64 release workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "x86_64-qemu-release"
                },
                {
                    "type": "build",
                    "name": "x86_64-qemu-release"
                }
            ]
        },
        {
            "name": "riscv-qemu-debug",
            "displayName": "RISC-V QEMU Debug Workflow",
            "description": "Complete RISC-V debug workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv-qemu-debug"
                },
                {
                    "type": "build",
                    "name": "riscv-qemu-debug"
                }
            ]
        },
        {
            "name": "riscv-qemu-release",
            "displayName": "RISC-V QEMU Release Workflow",
            "description": "Complete RISC-V release workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv-qemu-release"
                },
                {
                    "type": "build",
                    "name": "riscv-qemu-release"
                }
            ]
        }
    ],
    "testPresets": [
        {
            "name": "debug-test",
            "displayName": "Debug Test in QEMU",
            "configurePreset": "arm64-qemu-debug",
            "execution": {
                "timeout": 10
            }
        }
    ]
}