                }
            ]
        },
        {
            "name": "x86_64-qemu-release",
            "displayName": "x86-64 QEMU Release Workflow",
            "description": "Complete x86-64 release workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "x86_64-qemu-release"
                },
                {
                    "type": "build",
