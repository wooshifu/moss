                }
            ]
        },
        {
            "name": "debug",
            "displayName": "Default Debug Workflow",
            "description": "Default debug workflow (ARM64)",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug"
                }
            ]
        },
        {
            "name": "release",
            "displayName": "Default Release Workflow",
            "description": "Default release workflow (ARM64)",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                }
            ]
        },
        {
            "name": "debug-test",
            "displayName": "Debug Test Workflow",
            "description": "Debug build and test in QEMU",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug-test"
                }
            ]
        },
        {
            "name": "debug-gdb",
            "displayName": "Debug GDB Workflow",
            "description": "Debug build with GDB server",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
