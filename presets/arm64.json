{
    "version": 6,
    "configurePresets": [
        {
            "name": "arm64-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "displayName": "ARM64 Base Configuration",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "clang++-21",
                "CMAKE_ASM_COMPILER": "clang-21",
                "CMAKE_SYSTEM_NAME": "Generic",
                "MOSS_TARGET_PLATFORM": "QEMU_VIRT",
                "CMAKE_CXX_FLAGS": "-ffreestanding -fno-exceptions -fno-rtti -fno-stack-protector -Wall -Wextra -Werror -mcpu=cortex-a57 -march=armv8-a+lse -mgeneral-regs-only -mstrict-align -fno-pic -fno-pie",
                "CMAKE_CXX_COMPILER_TARGET": "aarch64-linux-gnu",
                "CMAKE_ASM_COMPILER_TARGET": "aarch64-linux-gnu",
                "CMAKE_SYSTEM_PROCESSOR": "aarch64",
                "CMAKE_CROSSCOMPILING": "TRUE",
                "MOSS_TARGET_ARCH": "ARM64",
                "CMAKE_EXE_LINKER_FLAGS": "-nostdlib -static -z max-page-size=4096"
            },
            "environment": {
                "CXX": "clang++-21"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": ["Linux"]
                }
            }
        },
        {
            "name": "arm64-qemu-debug",
            "displayName": "ARM64 QEMU Debug",
            "description": "ARM64 debug build for QEMU virt platform",
            "inherits": "arm64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-Og -g3"
            }
        },
        {
            "name": "arm64-qemu-release",
            "displayName": "ARM64 QEMU Release",
            "description": "ARM64 release build for QEMU virt platform",
            "inherits": "arm64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "arm64-qemu-debug",
            "displayName": "ARM64 QEMU Debug Build",
            "configurePreset": "arm64-qemu-debug",
            "targets": ["moss.elf"]
        },
        {
            "name": "arm64-qemu-release",
            "displayName": "ARM64 QEMU Release Build",
            "configurePreset": "arm64-qemu-release",
            "targets": ["moss.elf"]
        }
    ],
    "workflowPresets": [
        {
            "name": "arm64-qemu-debug",
            "displayName": "ARM64 QEMU Debug Workflow",
            "description": "Complete ARM64 debug workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "arm64-qemu-debug"
                },
                {
                    "type": "build",
                    "name": "arm64-qemu-debug"
                }
            ]
        },
        {
            "name": "arm64-qemu-release",
            "displayName": "ARM64 QEMU Release Workflow",
            "description": "Complete ARM64 release workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "arm64-qemu-release"
                },
                {
                    "type": "build",
                    "name": "arm64-qemu-release"
                }
            ]
        }
    ]
}