#!/bin/bash
set -e

# QEMU运行脚本模板
KERNEL_ELF="@CMAKE_BINARY_DIR@/bin/moss.elf"
KERNEL_BIN="@CMAKE_BINARY_DIR@/moss_boot.bin"  # 使用最小启动二进制文件（只包含.text.boot段）
KERNEL_BIN_FULL="@CMAKE_BINARY_DIR@/moss.bin"  # 完整版本（备用）
BUILD_DIR="@CMAKE_BINARY_DIR@"

# 解析命令行参数
USE_BINARY=false
DEBUG_MODE=false

for arg in "$@"; do
    case $arg in
        --bin)
            USE_BINARY=true
            shift
            ;;
        --debug)
            DEBUG_MODE=true
            shift
            ;;
        *)
            # 未知参数
            ;;
    esac
done

# 根据参数选择内核文件
if [ "$USE_BINARY" == "true" ]; then
    KERNEL_FILE="$KERNEL_BIN"
    KERNEL_TYPE="原始二进制"
    if [ ! -f "$KERNEL_BIN" ]; then
        echo "错误: 内核二进制文件不存在: $KERNEL_BIN"
        echo "请先运行构建命令生成 moss.bin"
        exit 1
    fi
else
    KERNEL_FILE="$KERNEL_ELF"
    KERNEL_TYPE="ELF可执行文件"
    if [ ! -f "$KERNEL_ELF" ]; then
        echo "错误: 内核ELF文件不存在: $KERNEL_ELF"
        echo "请先运行 'make' 构建内核"
        exit 1
    fi
fi

# 架构特定配置
ARCH="@MOSS_TARGET_ARCH@"
TARGET_PLATFORM="@MOSS_TARGET_PLATFORM@"

# 根据架构设置QEMU系统和参数
case "$ARCH" in
    "ARM64")
        QEMU_SYSTEM="qemu-system-aarch64"
        MACHINE_TYPE="virt"
        CPU_TYPE="cortex-a57"
        KERNEL_LOAD_ADDR="0x40000000"  # ARM64 ELF入口点
        EXTRA_ARGS="-semihosting-config enable=on,target=native"
        ;;
    "X86_64")
        QEMU_SYSTEM="qemu-system-x86_64"
        MACHINE_TYPE="q35"
        CPU_TYPE="qemu64"
        KERNEL_LOAD_ADDR="0x00100000"  # x86_64 加载地址
        EXTRA_ARGS=""
        ;;
    "RISCV")
        QEMU_SYSTEM="qemu-system-riscv64"
        MACHINE_TYPE="virt"
        CPU_TYPE="rv64"
        KERNEL_LOAD_ADDR="0x80200000"  # RISC-V 加载地址
        EXTRA_ARGS=""
        ;;
    *)
        echo "错误: 不支持的架构 $ARCH"
        exit 1
        ;;
esac

# 根据内核类型配置加载方式
if [ "$USE_BINARY" == "true" ]; then
    # 使用原始二进制文件
    KERNEL_ARGS="-device loader,file=$KERNEL_FILE,addr=$KERNEL_LOAD_ADDR,cpu-num=0,force-raw=on"
    MACHINE_ARGS="-machine $MACHINE_TYPE"
else
    # 使用ELF文件
    KERNEL_ARGS="-kernel $KERNEL_FILE"
    MACHINE_ARGS="-machine $MACHINE_TYPE"
fi

# QEMU参数配置
QEMU_ARGS=(
    $MACHINE_ARGS                   # 机器类型
    -cpu $CPU_TYPE                  # CPU类型
    -smp 4                          # 4个CPU核心
    -m 256M                         # 256MB内存
    $KERNEL_ARGS                    # 内核加载方式
    -nographic                      # 无图形界面
    -serial stdio                   # 串口重定向到终端
    -monitor none                   # 禁用QEMU监视器
    -no-reboot                      # 崩溃时不重启
)

# 添加架构特定的额外参数
if [ -n "$EXTRA_ARGS" ]; then
    QEMU_ARGS+=($EXTRA_ARGS)
fi

# 调试模式参数
DEBUG_ARGS=(
    -s                              # GDB服务器端口1234
    -S                              # 启动时暂停，等待GDB连接
)

echo "=================================================="
echo "           Moss ${ARCH}内核操作系统"
echo "=================================================="
echo "架构:       $ARCH"
echo "平台:       $TARGET_PLATFORM"
echo "内核文件:   $KERNEL_FILE"
echo "内核类型:   $KERNEL_TYPE"
echo "构建目录:   $BUILD_DIR"
if [ "$USE_BINARY" == "true" ]; then
    echo "加载地址:   $KERNEL_LOAD_ADDR"
    echo "二进制大小: $(ls -lh $KERNEL_FILE | awk '{print $5}')"
fi

if [ "$DEBUG_MODE" == "true" ]; then
    echo "调试模式: 启用"
    echo "GDB连接: target remote localhost:1234"
    echo "=================================================="
    echo "在另一个终端运行:"
    echo "  gdb $KERNEL_ELF"
    echo "  (gdb) target remote localhost:1234"
    echo "  (gdb) continue"
    echo "=================================================="
    echo ""
    echo "启动 $QEMU_SYSTEM 调试会话..."
    "$QEMU_SYSTEM" "${QEMU_ARGS[@]}" "${DEBUG_ARGS[@]}"
    QEMU_EXIT_CODE=$?
    echo ""
    echo "=== QEMU调试会话结束 ==="
    echo "退出状态: $QEMU_EXIT_CODE"
    exit $QEMU_EXIT_CODE
else
    echo "运行模式: 正常"
    echo "退出方式: Ctrl+A然后按X"
    echo "=================================================="
    echo ""
    echo "启动 $QEMU_SYSTEM..."
    "$QEMU_SYSTEM" "${QEMU_ARGS[@]}"
    QEMU_EXIT_CODE=$?
    echo ""
    if [ "$USE_BINARY" == "true" ]; then
        echo "=== MOSS内核执行完成 (原始二进制模式) ==="
    else
        echo "=== MOSS内核执行完成 (ELF模式) ==="
    fi
    echo "QEMU退出状态: $QEMU_EXIT_CODE"
    if [ $QEMU_EXIT_CODE -eq 0 ]; then
        echo "✅ 内核测试成功完成！"
    else
        echo "❌ 内核执行异常，退出码: $QEMU_EXIT_CODE"
    fi
    exit $QEMU_EXIT_CODE
fi

# 使用说明注释
# 使用方法:
#   ./run_qemu.sh                    # 运行ELF内核
#   ./run_qemu.sh --bin              # 运行原始二进制内核
#   ./run_qemu.sh --debug            # 调试ELF内核
#   ./run_qemu.sh --bin --debug      # 调试原始二进制内核