{
  "format": {
    "line_width": 120,
    "tab_size": 4,
    "use_tabchars": false,
    "separate_ctrl_name_with_space": false,
    "separate_fn_name_with_space": false,
    "dangle_parens": true,
    "dangle_align": "prefix",
    "max_pargs_hwrap": 4,
    "max_subgroups_hwrap": 2,
    "max_lines_hwrap": 2,
    "line_ending": "unix",
    "command_case": "lower",
    "keyword_case": "upper",
    "always_wrap": ["target_sources", "target_link_libraries"],
    "enable_sort": false,
    "autosort": false
  },
  "markup": {
    "enable_markup": true,
    "canonicalize_hashrulers": false,
    "first_comment_is_literal": true
  },
  "lint": {
    "max_arguments": 20,
    "max_statements": 100,
    "max_branches": 20
  }
}
