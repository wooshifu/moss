{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base-common",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_ASM_COMPILER": "clang",
                "CMAKE_SYSTEM_NAME": "Generic",
                "MOSS_TARGET_PLATFORM": "QEMU_VIRT",
                "CMAKE_C_FLAGS": "",
                "CMAKE_CXX_FLAGS": "",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -nostdlib -nostartfiles -static -T ${sourceDir}/src/linker/kernel_arm64.ld",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld -nostdlib"
            },
            "environment": {
            }
        }
    ]
}
