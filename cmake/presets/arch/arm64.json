{
    "version": 6,
    "include": ["../base.json"],
    "configurePresets": [
        {
            "name": "arm64-base",
            "hidden": true,
            "inherits": "base-common",
            "displayName": "ARM64 Base Configuration",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "$penv{CMAKE_CXX_FLAGS} -mcpu=cortex-a57 -march=armv8-a+lse -mgeneral-regs-only -mstrict-align",
                "CMAKE_CXX_COMPILER_TARGET": "aarch64-unknown-elf",
                "CMAKE_ASM_COMPILER_TARGET": "aarch64-unknown-elf",
                "CMAKE_SYSTEM_PROCESSOR": "aarch64",
                "CMAKE_CROSSCOMPILING": "TRUE",
                "MOSS_TARGET_ARCH": "ARM64",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -nostdlib -static -z max-page-size=4096"
            }
        },
        {
            "name": "arm64-qemu-debug",
            "displayName": "ARM64 QEMU Debug",
            "description": "ARM64 debug build for QEMU virt platform",
            "inherits": "arm64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-Og -g3"
            }
        },
        {
            "name": "arm64-qemu-release",
            "displayName": "ARM64 QEMU Release",
            "description": "ARM64 release build for QEMU virt platform",
            "inherits": "arm64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "arm64-qemu-debug",
            "displayName": "ARM64 QEMU Debug Build",
            "configurePreset": "arm64-qemu-debug",
            "targets": ["moss.elf", "moss.test.elf"]
        },
        {
            "name": "arm64-qemu-release",
            "displayName": "ARM64 QEMU Release Build",
            "configurePreset": "arm64-qemu-release",
            "targets": ["moss.elf", "moss.test.elf"]
        }
    ],
    "testPresets": [
        {
            "name": "arm64-qemu-debug-test",
            "displayName": "ARM64 Debug Unit Tests",
            "configurePreset": "arm64-qemu-debug",
            "execution": {
                "timeout": 30
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "arm64-qemu-release-test",
            "displayName": "ARM64 Release Unit Tests",
            "configurePreset": "arm64-qemu-release",
            "execution": {
                "timeout": 30
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "arm64-qemu-debug",
            "displayName": "ARM64 QEMU Debug Workflow",
            "description": "Configure, build (moss.elf + moss.test.elf), and run tests",
            "steps": [
                { "type": "configure", "name": "arm64-qemu-debug" },
                { "type": "build", "name": "arm64-qemu-debug" },
                { "type": "test", "name": "arm64-qemu-debug-test" }
            ]
        },
        {
            "name": "arm64-qemu-release",
            "displayName": "ARM64 QEMU Release Workflow",
            "description": "Configure, build (moss.elf + moss.test.elf), and run tests",
            "steps": [
                { "type": "configure", "name": "arm64-qemu-release" },
                { "type": "build", "name": "arm64-qemu-release" },
                { "type": "test", "name": "arm64-qemu-release-test" }
            ]
        }
    ]
}
