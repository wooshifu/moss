{
    "version": 6,
    "include": ["../base.json"],
    "configurePresets": [
        {
            "name": "riscv-base",
            "hidden": true,
            "inherits": "base-common",
            "displayName": "RISC-V Base Configuration",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=rv64imac -mabi=lp64 -mcmodel=medany -mstrict-align -ffreestanding -fno-stack-protector -fno-pic -fno-pie",
                "CMAKE_CXX_FLAGS": "-march=rv64imac -mabi=lp64 -mcmodel=medany -mstrict-align -ffreestanding -fno-exceptions -fno-rtti -fno-stack-protector -fno-pic -fno-pie -Weverything -Werror -Wno-c++-compat -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-c++11-compat -Wno-c++14-compat -Wno-c++17-compat -Wno-c++20-compat -Wno-padded -Wno-unsafe-buffer-usage -Wno-gnu-zero-variadic-macro-arguments -Wno-gnu-anonymous-struct -Wno-nested-anon-types -Wno-missing-prototypes -Wno-missing-variable-declarations -Wno-global-constructors -Wno-exit-time-destructors -Wno-weak-vtables -Wno-inline -Wno-reserved-identifier -Wno-reserved-macro-identifier -Wno-covered-switch-default -Wno-nrvo -Wno-lifetime-safety-suggestions",
                "CMAKE_ASM_FLAGS": "-march=rv64imac",
                "CMAKE_C_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_CXX_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_ASM_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_SYSTEM_PROCESSOR": "riscv64",
                "CMAKE_CROSSCOMPILING": "TRUE",
                "MOSS_TARGET_ARCH": "RISCV",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -nostdlib -nostartfiles -static -T ${sourceDir}/src/linker/kernel_riscv.ld"
            }
        },
        {
            "name": "riscv-qemu-debug",
            "displayName": "RISC-V QEMU Debug",
            "description": "RISC-V 64 debug build for QEMU virt platform",
            "inherits": ["riscv-base", "build-debug"]
        },
        {
            "name": "riscv-qemu-release",
            "displayName": "RISC-V QEMU Release",
            "description": "RISC-V 64 release build for QEMU virt platform",
            "inherits": ["riscv-base", "build-release"]
        },
        {
            "name": "riscv-qemu-relwithdebinfo",
            "displayName": "RISC-V QEMU RelWithDebInfo",
            "description": "RISC-V 64 optimized build with debug information for QEMU virt platform",
            "inherits": ["riscv-base", "build-relwithdebinfo"]
        }
    ],
    "buildPresets": [
        {
            "name": "riscv-qemu-debug",
            "displayName": "RISC-V QEMU Debug Build",
            "configurePreset": "riscv-qemu-debug",
            "targets": ["moss.elf", "moss.test.elf"]
        },
        {
            "name": "riscv-qemu-release",
            "displayName": "RISC-V QEMU Release Build",
            "configurePreset": "riscv-qemu-release",
            "targets": ["moss.elf", "moss.test.elf"]
        },
        {
            "name": "riscv-qemu-relwithdebinfo",
            "displayName": "RISC-V QEMU RelWithDebInfo Build",
            "configurePreset": "riscv-qemu-relwithdebinfo",
            "targets": ["moss.elf", "moss.test.elf"]
        }
    ],
    "testPresets": [
        {
            "name": "riscv-qemu-debug-test",
            "displayName": "RISC-V Debug Unit Tests",
            "configurePreset": "riscv-qemu-debug",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "riscv-qemu-release-test",
            "displayName": "RISC-V Release Unit Tests",
            "configurePreset": "riscv-qemu-release",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "riscv-qemu-relwithdebinfo-test",
            "displayName": "RISC-V RelWithDebInfo Unit Tests",
            "configurePreset": "riscv-qemu-relwithdebinfo",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "riscv-qemu-debug",
            "displayName": "RISC-V QEMU Debug Workflow",
            "description": "Configure and build (moss.elf + moss.test.elf)",
            "steps": [
                { "type": "configure", "name": "riscv-qemu-debug" },
                { "type": "build", "name": "riscv-qemu-debug" }
            ]
        },
        {
            "name": "riscv-qemu-release",
            "displayName": "RISC-V QEMU Release Workflow",
            "description": "Configure and build (moss.elf + moss.test.elf)",
            "steps": [
                { "type": "configure", "name": "riscv-qemu-release" },
                { "type": "build", "name": "riscv-qemu-release" }
            ]
        },
        {
            "name": "riscv-qemu-relwithdebinfo",
            "displayName": "RISC-V QEMU RelWithDebInfo Workflow",
            "description": "Configure and build (moss.elf + moss.test.elf)",
            "steps": [
                { "type": "configure", "name": "riscv-qemu-relwithdebinfo" },
                { "type": "build", "name": "riscv-qemu-relwithdebinfo" }
            ]
        }
    ]
}
