{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base-riscv",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "clang-21",
                "CMAKE_CXX_COMPILER": "clang++-21",
                "CMAKE_ASM_COMPILER": "clang-21",
                "CMAKE_SYSTEM_NAME": "Generic",
                "MOSS_TARGET_PLATFORM": "QEMU_VIRT",
                "CMAKE_CXX_FLAGS": "-ffreestanding -fno-exceptions -fno-rtti -fno-stack-protector -Wall -Wextra -Werror -fno-pic -fno-pie"
            },
            "environment": {
                "CXX": "clang++-21"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": ["Linux"]
                }
            }
        },
        {
            "name": "riscv-base",
            "hidden": true,
            "inherits": "base-riscv",
            "displayName": "RISC-V Base Configuration",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "$penv{CMAKE_CXX_FLAGS} -march=rv64imac -mabi=lp64 -mcmodel=medany -mstrict-align",
                "CMAKE_CXX_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_ASM_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_SYSTEM_PROCESSOR": "riscv64",
                "CMAKE_CROSSCOMPILING": "TRUE",
                "MOSS_TARGET_ARCH": "RISCV",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -nostdlib -nostartfiles",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld -nostdlib"
            }
        },
        {
            "name": "riscv-qemu-debug",
            "displayName": "RISC-V QEMU Debug",
            "description": "RISC-V 64 debug build for QEMU virt platform",
            "inherits": "riscv-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-Og -g3"
            }
        },
        {
            "name": "riscv-qemu-release",
            "displayName": "RISC-V QEMU Release",
            "description": "RISC-V 64 release build for QEMU virt platform",
            "inherits": "riscv-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "riscv-qemu-debug",
            "displayName": "RISC-V QEMU Debug Build",
            "configurePreset": "riscv-qemu-debug",
            "targets": ["moss.elf"]
        },
        {
            "name": "riscv-qemu-release",
            "displayName": "RISC-V QEMU Release Build",
            "configurePreset": "riscv-qemu-release",
            "targets": ["moss.elf"]
        }
    ],
    "workflowPresets": [
        {
            "name": "riscv-qemu-debug",
            "displayName": "RISC-V QEMU Debug Workflow",
            "description": "Complete RISC-V debug workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv-qemu-debug"
                },
                {
                    "type": "build",
                    "name": "riscv-qemu-debug"
                }
            ]
        },
        {
            "name": "riscv-qemu-release",
            "displayName": "RISC-V QEMU Release Workflow",
            "description": "Complete RISC-V release workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv-qemu-release"
                },
                {
                    "type": "build",
                    "name": "riscv-qemu-release"
                }
            ]
        }
    ]
}