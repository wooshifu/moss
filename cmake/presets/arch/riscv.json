{
    "version": 6,
    "include": [
        "../base.json"
    ],
    "configurePresets": [
        {
            "name": "riscv-base",
            "hidden": true,
            "inherits": "base-common",
            "displayName": "RISC-V Base Configuration",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=rv64imac -mabi=lp64 -mcmodel=medany -mstrict-align -ffreestanding -fno-stack-protector -fpie",
                "CMAKE_CXX_FLAGS": "-march=rv64imac -mabi=lp64 -mcmodel=medany -mstrict-align -ffreestanding -fno-exceptions -fno-rtti -fno-stack-protector -fpie -Weverything -Werror -Wno-c++-compat -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-c++11-compat -Wno-c++14-compat -Wno-c++17-compat -Wno-c++20-compat -Wno-padded -Wno-unsafe-buffer-usage -Wno-gnu-zero-variadic-macro-arguments -Wno-gnu-anonymous-struct -Wno-nested-anon-types -Wno-missing-prototypes -Wno-missing-variable-declarations -Wno-global-constructors -Wno-exit-time-destructors -Wno-weak-vtables -Wno-inline -Wno-reserved-identifier -Wno-reserved-macro-identifier -Wno-covered-switch-default -Wno-nrvo -Wno-lifetime-safety-suggestions",
                "CMAKE_ASM_FLAGS": "-march=rv64imac",
                "CMAKE_C_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_CXX_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_ASM_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_SYSTEM_PROCESSOR": "riscv64",
                "CMAKE_CROSSCOMPILING": "TRUE",
                "MOSS_TARGET_ARCH": "RISCV",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -nostdlib -nostartfiles -Wl,-pie,--no-dynamic-linker,-z,notext,-Bsymbolic -T ${sourceDir}/src/linker/kernel_riscv.ld"
            }
        },
        {
            "name": "riscv-debug",
            "displayName": "RISC-V Debug",
            "description": "RISC-V 64 debug build",
            "inherits": [
                "riscv-base",
                "build-debug"
            ]
        },
        {
            "name": "riscv-release",
            "displayName": "RISC-V Release",
            "description": "RISC-V 64 release build",
            "inherits": [
                "riscv-base",
                "build-release"
            ]
        },
        {
            "name": "riscv-relwithdebinfo",
            "displayName": "RISC-V RelWithDebInfo",
            "description": "RISC-V 64 optimized build with debug information",
            "inherits": [
                "riscv-base",
                "build-relwithdebinfo"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "riscv-debug",
            "displayName": "RISC-V Debug Build",
            "configurePreset": "riscv-debug"
        },
        {
            "name": "riscv-release",
            "displayName": "RISC-V Release Build",
            "configurePreset": "riscv-release"
        },
        {
            "name": "riscv-relwithdebinfo",
            "displayName": "RISC-V RelWithDebInfo Build",
            "configurePreset": "riscv-relwithdebinfo"
        }
    ],
    "testPresets": [
        {
            "name": "riscv-debug-test",
            "displayName": "RISC-V Debug Unit Tests",
            "configurePreset": "riscv-debug",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "riscv-release-test",
            "displayName": "RISC-V Release Unit Tests",
            "configurePreset": "riscv-release",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "riscv-relwithdebinfo-test",
            "displayName": "RISC-V RelWithDebInfo Unit Tests",
            "configurePreset": "riscv-relwithdebinfo",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "riscv-debug",
            "displayName": "RISC-V Debug Workflow",
            "description": "Configure and build kernel artifacts",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv-debug"
                },
                {
                    "type": "build",
                    "name": "riscv-debug"
                }
            ]
        },
        {
            "name": "riscv-release",
            "displayName": "RISC-V Release Workflow",
            "description": "Configure and build kernel artifacts",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv-release"
                },
                {
                    "type": "build",
                    "name": "riscv-release"
                }
            ]
        },
        {
            "name": "riscv-relwithdebinfo",
            "displayName": "RISC-V RelWithDebInfo Workflow",
            "description": "Configure and build kernel artifacts",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv-relwithdebinfo"
                },
                {
                    "type": "build",
                    "name": "riscv-relwithdebinfo"
                }
            ]
        }
    ]
}
