{
    "version": 6,
    "include": [
        "../base.json"
    ],
    "configurePresets": [
        {
            "name": "x64-base",
            "hidden": true,
            "inherits": "base-common",
            "displayName": "x64 Base Configuration",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "",
                "CMAKE_CXX_FLAGS": "-mno-red-zone -mno-mmx -mno-sse -mno-sse2 -mno-sse3 -mno-ssse3 -mno-sse4.1 -mno-sse4.2 -mno-avx -mno-avx2 -mno-80387 -mno-fp-ret-in-387 -mtune=x86-64 -mcmodel=kernel -ffreestanding -fno-exceptions -fno-rtti -fno-stack-protector -fno-pic -fno-pie -Weverything -Werror -Wno-c++-compat -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-c++11-compat -Wno-c++14-compat -Wno-c++17-compat -Wno-c++20-compat -Wno-padded -Wno-unsafe-buffer-usage -Wno-gnu-zero-variadic-macro-arguments -Wno-gnu-anonymous-struct -Wno-nested-anon-types -Wno-missing-prototypes -Wno-missing-variable-declarations -Wno-global-constructors -Wno-exit-time-destructors -Wno-weak-vtables -Wno-inline -Wno-reserved-identifier -Wno-reserved-macro-identifier -Wno-covered-switch-default -Wno-nrvo -Wno-lifetime-safety-suggestions",
                "CMAKE_ASM_FLAGS": "-m64",
                "CMAKE_C_COMPILER_TARGET": "x86_64-unknown-linux-elf",
                "CMAKE_CXX_COMPILER_TARGET": "x86_64-unknown-linux-elf",
                "CMAKE_ASM_COMPILER_TARGET": "x86_64-unknown-linux-elf",
                "CMAKE_SYSTEM_PROCESSOR": "x86_64",
                "CMAKE_CROSSCOMPILING": "FALSE",
                "MOSS_TARGET_ARCH": "X64",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -nostdlib -nostartfiles -static -T ${sourceDir}/src/linker/kernel_x64.ld"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "description": "x64 debug build for platform",
            "inherits": [
                "x64-base",
                "build-debug"
            ]
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "description": "x64 release build for platform",
            "inherits": [
                "x64-base",
                "build-release"
            ]
        },
        {
            "name": "x64-relwithdebinfo",
            "displayName": "x64 RelWithDebInfo",
            "description": "x64 optimized build with debug information for platform",
            "inherits": [
                "x64-base",
                "build-relwithdebinfo"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "x64-debug",
            "displayName": "x64 Debug Build",
            "configurePreset": "x64-debug"
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release Build",
            "configurePreset": "x64-release"
        },
        {
            "name": "x64-relwithdebinfo",
            "displayName": "x64 RelWithDebInfo Build",
            "configurePreset": "x64-relwithdebinfo"
        }
    ],
    "testPresets": [
        {
            "name": "x64-debug-test",
            "displayName": "x64 Debug Unit Tests",
            "configurePreset": "x64-debug",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x64-release-test",
            "displayName": "x64 Release Unit Tests",
            "configurePreset": "x64-release",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x64-relwithdebinfo-test",
            "displayName": "x64 RelWithDebInfo Unit Tests",
            "configurePreset": "x64-relwithdebinfo",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "x64-debug",
            "displayName": "x64 Debug Workflow",
            "description": "Configure, build and test kernel artifacts",
            "steps": [
                {
                    "type": "configure",
                    "name": "x64-debug"
                },
                {
                    "type": "build",
                    "name": "x64-debug"
                },
                {
                    "type": "test",
                    "name": "x64-debug-test"
                }
            ]
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release Workflow",
            "description": "Configure, build and test kernel artifacts",
            "steps": [
                {
                    "type": "configure",
                    "name": "x64-release"
                },
                {
                    "type": "build",
                    "name": "x64-release"
                },
                {
                    "type": "test",
                    "name": "x64-release-test"
                }
            ]
        },
        {
            "name": "x64-relwithdebinfo",
            "displayName": "x64 RelWithDebInfo Workflow",
            "description": "Configure, build and test kernel artifacts",
            "steps": [
                {
                    "type": "configure",
                    "name": "x64-relwithdebinfo"
                },
                {
                    "type": "build",
                    "name": "x64-relwithdebinfo"
                },
                {
                    "type": "test",
                    "name": "x64-relwithdebinfo-test"
                }
            ]
        }
    ]
}
