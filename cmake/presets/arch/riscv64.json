{
    "version": 6,
    "include": [
        "../base.json"
    ],
    "configurePresets": [
        {
            "name": "riscv64-base",
            "hidden": true,
            "inherits": "base-common",
            "displayName": "RISC-V 64 Base Configuration",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=rv64imac -mabi=lp64 -mcmodel=medany -mstrict-align -ffreestanding -fno-stack-protector -fpie",
                "CMAKE_CXX_FLAGS": "-march=rv64imac -mabi=lp64 -mcmodel=medany -mstrict-align -ffreestanding -fno-exceptions -fno-rtti -fno-stack-protector -fpie -Weverything -Werror -Wno-c++-compat -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-c++11-compat -Wno-c++14-compat -Wno-c++17-compat -Wno-c++20-compat -Wno-padded -Wno-unsafe-buffer-usage -Wno-gnu-zero-variadic-macro-arguments -Wno-gnu-anonymous-struct -Wno-nested-anon-types -Wno-missing-prototypes -Wno-missing-variable-declarations -Wno-global-constructors -Wno-exit-time-destructors -Wno-weak-vtables -Wno-inline -Wno-reserved-identifier -Wno-reserved-macro-identifier -Wno-covered-switch-default -Wno-nrvo -Wno-lifetime-safety-suggestions",
                "CMAKE_ASM_FLAGS": "-march=rv64imac",
                "CMAKE_C_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_CXX_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_ASM_COMPILER_TARGET": "riscv64-unknown-elf",
                "CMAKE_SYSTEM_PROCESSOR": "riscv64",
                "CMAKE_CROSSCOMPILING": "TRUE",
                "MOSS_TARGET_ARCH": "RISCV64",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -nostdlib -nostartfiles -Wl,-pie,--no-dynamic-linker,-z,notext,-Bsymbolic -T ${sourceDir}/src/linker/kernel_riscv64.ld"
            }
        },
        {
            "name": "riscv64-debug",
            "displayName": "RISC-V 64 Debug",
            "description": "RISC-V 64 debug build",
            "inherits": [
                "riscv64-base",
                "build-debug"
            ]
        },
        {
            "name": "riscv64-release",
            "displayName": "RISC-V 64 Release",
            "description": "RISC-V 64 release build",
            "inherits": [
                "riscv64-base",
                "build-release"
            ]
        },
        {
            "name": "riscv64-relwithdebinfo",
            "displayName": "RISC-V 64 RelWithDebInfo",
            "description": "RISC-V 64 optimized build with debug information",
            "inherits": [
                "riscv64-base",
                "build-relwithdebinfo"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "riscv64-debug",
            "displayName": "RISC-V 64 Debug Build",
            "configurePreset": "riscv64-debug"
        },
        {
            "name": "riscv64-release",
            "displayName": "RISC-V 64 Release Build",
            "configurePreset": "riscv64-release"
        },
        {
            "name": "riscv64-relwithdebinfo",
            "displayName": "RISC-V 64 RelWithDebInfo Build",
            "configurePreset": "riscv64-relwithdebinfo"
        }
    ],
    "testPresets": [
        {
            "name": "riscv64-debug-test",
            "displayName": "RISC-V 64 Debug Unit Tests",
            "configurePreset": "riscv64-debug",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "riscv64-release-test",
            "displayName": "RISC-V 64 Release Unit Tests",
            "configurePreset": "riscv64-release",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "riscv64-relwithdebinfo-test",
            "displayName": "RISC-V 64 RelWithDebInfo Unit Tests",
            "configurePreset": "riscv64-relwithdebinfo",
            "execution": {
                "timeout": 420
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "riscv64-debug",
            "displayName": "RISC-V 64 Debug Workflow",
            "description": "Configure, build and test kernel artifacts",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv64-debug"
                },
                {
                    "type": "build",
                    "name": "riscv64-debug"
                },
                {
                    "type": "test",
                    "name": "riscv64-debug-test"
                }
            ]
        },
        {
            "name": "riscv64-release",
            "displayName": "RISC-V 64 Release Workflow",
            "description": "Configure, build and test kernel artifacts",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv64-release"
                },
                {
                    "type": "build",
                    "name": "riscv64-release"
                },
                {
                    "type": "test",
                    "name": "riscv64-release-test"
                }
            ]
        },
        {
            "name": "riscv64-relwithdebinfo",
            "displayName": "RISC-V 64 RelWithDebInfo Workflow",
            "description": "Configure, build and test kernel artifacts",
            "steps": [
                {
                    "type": "configure",
                    "name": "riscv64-relwithdebinfo"
                },
                {
                    "type": "build",
                    "name": "riscv64-relwithdebinfo"
                },
                {
                    "type": "test",
                    "name": "riscv64-relwithdebinfo-test"
                }
            ]
        }
    ]
}
