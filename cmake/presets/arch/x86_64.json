{
    "version": 6,
    "include": ["../base.json"],
    "configurePresets": [
        {
            "name": "x86_64-base",
            "hidden": true,
            "inherits": "base-common",
            "displayName": "x86_64 Base Configuration",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "",
                "CMAKE_CXX_FLAGS": "-mno-red-zone -mno-mmx -mno-sse -mno-sse2 -mno-sse3 -mno-ssse3 -mno-sse4.1 -mno-sse4.2 -mno-avx -mno-avx2 -mno-80387 -mno-fp-ret-in-387 -mtune=x86-64 -mcmodel=kernel -ffreestanding -fno-exceptions -fno-rtti -fno-stack-protector -fno-pic -fno-pie -Weverything -Werror -Wno-c++-compat -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-c++11-compat -Wno-c++14-compat -Wno-c++17-compat -Wno-c++20-compat -Wno-padded -Wno-unsafe-buffer-usage -Wno-gnu-zero-variadic-macro-arguments -Wno-gnu-anonymous-struct -Wno-nested-anon-types -Wno-missing-prototypes -Wno-missing-variable-declarations -Wno-global-constructors -Wno-exit-time-destructors -Wno-weak-vtables -Wno-inline -Wno-reserved-identifier -Wno-reserved-macro-identifier -Wno-covered-switch-default -Wno-nrvo -Wno-lifetime-safety-suggestions",
                "CMAKE_ASM_FLAGS": "-m64",
                "CMAKE_C_COMPILER_TARGET": "x86_64-unknown-linux-elf",
                "CMAKE_CXX_COMPILER_TARGET": "x86_64-unknown-linux-elf",
                "CMAKE_ASM_COMPILER_TARGET": "x86_64-unknown-linux-elf",
                "CMAKE_SYSTEM_PROCESSOR": "x86_64",
                "CMAKE_CROSSCOMPILING": "FALSE",
                "MOSS_TARGET_ARCH": "X86_64",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -nostdlib -nostartfiles -static -T ${sourceDir}/src/linker/kernel_x86_64.ld"
            }
        },
        {
            "name": "x86_64-qemu-debug",
            "displayName": "x86-64 QEMU Debug",
            "description": "x86-64 debug build for QEMU platform",
            "inherits": ["x86_64-base", "build-debug"]
        },
        {
            "name": "x86_64-qemu-release",
            "displayName": "x86-64 QEMU Release",
            "description": "x86-64 release build for QEMU platform",
            "inherits": ["x86_64-base", "build-release"]
        },
        {
            "name": "x86_64-qemu-relwithdebinfo",
            "displayName": "x86-64 QEMU RelWithDebInfo",
            "description": "x86-64 optimized build with debug information for QEMU platform",
            "inherits": ["x86_64-base", "build-relwithdebinfo"]
        }
    ],
    "buildPresets": [
        {
            "name": "x86_64-qemu-debug",
            "displayName": "x86-64 QEMU Debug Build",
            "configurePreset": "x86_64-qemu-debug",
            "targets": ["moss.elf", "moss.test.elf"]
        },
        {
            "name": "x86_64-qemu-release",
            "displayName": "x86-64 QEMU Release Build",
            "configurePreset": "x86_64-qemu-release",
            "targets": ["moss.elf", "moss.test.elf"]
        },
        {
            "name": "x86_64-qemu-relwithdebinfo",
            "displayName": "x86-64 QEMU RelWithDebInfo Build",
            "configurePreset": "x86_64-qemu-relwithdebinfo",
            "targets": ["moss.elf", "moss.test.elf"]
        }
    ],
    "testPresets": [
        {
            "name": "x86_64-qemu-debug-test",
            "displayName": "x86-64 Debug Unit Tests",
            "configurePreset": "x86_64-qemu-debug",
            "execution": {
                "timeout": 30
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x86_64-qemu-release-test",
            "displayName": "x86-64 Release Unit Tests",
            "configurePreset": "x86_64-qemu-release",
            "execution": {
                "timeout": 30
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x86_64-qemu-relwithdebinfo-test",
            "displayName": "x86-64 RelWithDebInfo Unit Tests",
            "configurePreset": "x86_64-qemu-relwithdebinfo",
            "execution": {
                "timeout": 30
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "x86_64-qemu-debug",
            "displayName": "x86-64 QEMU Debug Workflow",
            "description": "Configure and build (moss.elf + moss.test.elf)",
            "steps": [
                { "type": "configure", "name": "x86_64-qemu-debug" },
                { "type": "build", "name": "x86_64-qemu-debug" }
            ]
        },
        {
            "name": "x86_64-qemu-release",
            "displayName": "x86-64 QEMU Release Workflow",
            "description": "Configure and build (moss.elf + moss.test.elf)",
            "steps": [
                { "type": "configure", "name": "x86_64-qemu-release" },
                { "type": "build", "name": "x86_64-qemu-release" }
            ]
        },
        {
            "name": "x86_64-qemu-relwithdebinfo",
            "displayName": "x86-64 QEMU RelWithDebInfo Workflow",
            "description": "Configure and build (moss.elf + moss.test.elf)",
            "steps": [
                { "type": "configure", "name": "x86_64-qemu-relwithdebinfo" },
                { "type": "build", "name": "x86_64-qemu-relwithdebinfo" }
            ]
        }
    ]
}
